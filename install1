<#
.SYNOPSIS
Hermes Agent Windows Installer

.DESCRIPTION
Installs Hermes Agent on native Windows without WSL.
#>

$ErrorActionPreference = 'Stop'

# Require PowerShell 5.1 or newer
if ($PSVersionTable.PSVersion.Major -lt 5) {
    Write-Error "PowerShell 5.1 or newer is required. Please update PowerShell."
}

#region Helpers
function Write-Step {
    param([string]$Message)
    Write-Host "`n→ $Message" -ForegroundColor Cyan
}

function Write-Success {
    param([string]$Message)
    Write-Host "`n✓ $Message" -ForegroundColor Green
}

function Write-Warning {
    param([string]$Message)
    Write-Host "`n⚠ $Message" -ForegroundColor Yellow
}

function Write-ErrorExit {
    param([string]$Message)
    Write-Host "`n✗ $Message" -ForegroundColor Red
    exit 1
}
#endregion

#region Config
$HermesHome = Join-Path $env:USERPROFILE ".hermes"
$InstallDir = Join-Path $env:LOCALAPPDATA "hermes\hermes-agent"
$GitUrl = "https://ghfast.top/https://github.com/NousResearch/hermes-agent.git"
$MinPythonVersion = "3.10"
$RecommendedPython = "3.11"
#endregion

Write-Host "`n=============================================" -ForegroundColor Cyan
Write-Host "        Hermes Agent Windows Installer" -ForegroundColor Cyan
Write-Host "=============================================" -ForegroundColor Cyan

# Create directories
Write-Step "Creating directories"
New-Item -Path $HermesHome -ItemType Directory -Force | Out-Null
New-Item -Path $InstallDir -ItemType Directory -Force | Out-Null

# Check Git
Write-Step "Checking Git"
if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    Write-Warning "Git not found, installing portable Git"
    $GitZip = Join-Path $env:TEMP "git-portable.zip"
    Invoke-WebRequest -Uri "https://ghfast.top/https://github.com/git-for-windows/git/releases/download/v2.45.1.windows.1/PortableGit-2.45.1-64-bit.zip" -OutFile $GitZip
    Expand-Archive -Path $GitZip -DestinationPath (Join-Path $env:LOCALAPPDATA "hermes\git") -Force
    Remove-Item $GitZip -Force
    $env:PATH += ";" + (Join-Path $env:LOCALAPPDATA "hermes\git\cmd")
}

# Clone/update repo
Write-Step "Cloning/updating Hermes Agent repository"
if (Test-Path (Join-Path $InstallDir ".git")) {
    Push-Location $InstallDir
    git pull
    Pop-Location
} else {
    git clone $GitUrl $InstallDir
}

# Check Python/uv
Write-Step "Checking Python $RecommendedPython"
$venvDir = Join-Path $InstallDir "venv"
$uvExe = Join-Path $env:LOCALAPPDATA "hermes\uv\uv.exe"

if (-not (Test-Path $uvExe)) {
    Write-Warning "uv not found, installing uv"
    $UvDir = Join-Path $env:LOCALAPPDATA "hermes\uv"
    New-Item -Path $UvDir -ItemType Directory -Force | Out-Null
    Invoke-WebRequest -Uri "https://ghfast.top/https://github.com/astral-sh/uv/releases/download/0.5.13/uv-x86_64-pc-windows-msvc.zip" -OutFile (Join-Path $UvDir "uv.zip")
    Expand-Archive -Path (Join-Path $UvDir "uv.zip") -DestinationPath $UvDir -Force
    Remove-Item (Join-Path $UvDir "uv.zip") -Force
    $env:PATH += ";$UvDir"
}

# Create venv
Write-Step "Creating virtual environment"
if (-not (Test-Path $venvDir)) {
    & $uvExe venv $venvDir
}
$env:VIRTUAL_ENV = $venvDir

# Install dependencies
Write-Step "Installing dependencies (this may take a few minutes)"
Push-Location $InstallDir
$env:UV_PROJECT_ENVIRONMENT = $venvDir
& $uvExe sync --extra all --index-url https://pypi.mirrors.ustc.edu.cn/simple/
Pop-Location

# ===================== 在这里加入修复命令 =====================
Write-Step "Installing edge-tts fix (prevent startup freeze)"
& "$venvDir\Scripts\pip.exe" install edge-tts -i https://pypi.mirrors.ustc.edu.cn/simple/
# ==============================================================

# Verify critical imports
Write-Step "Verifying installation"
$venvPython = Join-Path $venvDir "Scripts\python.exe"
try {
    & $venvPython -c "import dotenv, openai, rich, prompt_toolkit"
} catch {
    Write-ErrorExit "Dependency verification failed: $_"
}

# Add to PATH
Write-Step "Adding hermes to PATH"
$HermesBin = Join-Path $venvDir "Scripts"
if (-not ($env:PATH -like "*$HermesBin*")) {
    [Environment]::SetEnvironmentVariable("PATH", "$env:PATH;$HermesBin", "User")
    $env:PATH += ";$HermesBin"
}

Write-Success "Hermes Agent installed successfully!"
Write-Host "`nTo start, run: hermes" -ForegroundColor Cyan
Write-Host "=============================================`n" -ForegroundColor Cyan
